+
+function SectionPicker({ sections, selected, onChange, showRelogHint }: SectionPickerProps) {
+  const toggle = (section: string) => {
+    onChange(
+      selected.includes(section)
+        ? selected.filter((s) => s !== section)
+        : [...selected, section],
+    );
+  };
+  const sorted = [
+    ...sections.filter((s) => !RELOG_REQUIRED_SECTIONS.has(s)),
+    ...sections.filter((s) => RELOG_REQUIRED_SECTIONS.has(s)),
+  ];
+  return (
+    <div className="flex flex-wrap gap-2 py-1">
+      {sorted.map((section) => (
+        <label
+          key={section}
+          className="flex items-center gap-1 cursor-pointer text-sm select-none"
+          style={{ color: "inherit" }}
+        >
+          <input
+            type="checkbox"
+            checked={selected.includes(section)}
+            onChange={() => toggle(section)}
+            className="accent-current"
+          />
+          {section}
+          {showRelogHint && RELOG_REQUIRED_SECTIONS.has(section) ? " (on logout)" : ""}
+        </label>
+      ))}
+    </div>
+  );
+}
