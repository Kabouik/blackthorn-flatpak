+const DEFERRED_SECTIONS = new Set(["Panels", "Chat", "NameOptions"]);
+const _deferredWatchers = new Map<string, () => void>();
+
+function scheduleDeferredApply(job: {
+  characterName: string;
+  snapshotName: string;
+  sections: string[];
+  iniDirectory: string;
+  snapshotDirectory: string;
+  logger?: { info: (message: string, details?: unknown) => void; error: (message: string, details?: unknown) => void };
+}): void {
+  _deferredWatchers.get(job.characterName)?.();
+  const iniPath = path.join(job.iniDirectory, `${job.characterName}-5.ini`);
+  let cancelled = false;
+  let debounce: ReturnType<typeof setTimeout> | null = null;
+  const watcher = watch(iniPath, { persistent: false }, () => {
+    if (cancelled) return;
+    if (debounce) clearTimeout(debounce);
+    debounce = setTimeout(() => {
+      if (cancelled) return;
+      void applyPanelSnapshot({
+        iniDirectory: job.iniDirectory,
+        snapshotDirectory: job.snapshotDirectory,
+        characterName: job.characterName,
+        snapshotName: job.snapshotName,
+        sections: job.sections,
+      })
+        .then(() =>
+          job.logger?.info("[INI panels] deferred apply done", { characterName: job.characterName }),
+        )
+        .catch((err: unknown) =>
+          job.logger?.error("[INI panels] deferred apply failed", {
+            characterName: job.characterName,
+            err: String(err),
+          }),
+        );
+    }, 800);
+  });
+  _deferredWatchers.set(job.characterName, () => {
+    cancelled = true;
+    if (debounce) clearTimeout(debounce);
+    watcher.close();
+  });
+}
