+    applyPanelSnapshotToAllCharacters: async (
+      snapshotName: string,
+      sections?: string[],
+    ) => {
+      await activeDaocProcessId();
+      if (!options.cefLifecycle)
+        throw new Error("CEF game bridge is not configured.");
+      const config = await context.config.load();
+      const iniDirectory = resolveSpecSwapDirectory({
+        platform: context.platform,
+        environment: context.environment,
+        winePrefix: config.uiOptions.linuxWinePrefix,
+      });
+      const snapshotDirectory = resolvePanelSnapshotDirectory(
+        context.config.file,
+      );
+      const characters = await listCharactersInIniDirectory(iniDirectory);
+      options.logger?.info("[INI panels] applying snapshot to all characters", {
+        snapshotName,
+        sections,
+        characters,
+      });
+      for (const characterName of characters) {
+        await options.cefLifecycle.requestProfileIni("save", characterName);
+        await applyPanelSnapshot({
+          iniDirectory,
+          snapshotDirectory,
+          characterName,
+          snapshotName,
+          sections,
+        });
+      }
+      // Reload the active character's profile in the running game.
+      const activeCharacters = context.state.activeWindows;
+      const activeCharacter =
+        activeCharacters.length > 0 ? activeCharacters[0] : characters[0];
+      if (activeCharacter) {
+        await options.cefLifecycle.requestProfileIni("reload", activeCharacter);
+      }
+      options.logger?.info(
+        "[INI panels] apply-to-all completed",
+        { snapshotName, characters },
+      );
